{
  "duration": {
    "$type": "duration",
    "100": { "$value": "100ms" },
    "150": { "$value": "150ms" },
    "250": { "$value": "250ms" },
    "400": { "$value": "400ms" }
  },
  "easing": {
    "$type": "cubicBezier",
    "standard": { "$value": [0.2, 0, 0, 1] },
    "decelerate": { "$value": [0, 0, 0, 1] },
    "accelerate": { "$value": [0.3, 0, 1, 1] }
  }
}

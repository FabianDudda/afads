{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "Roboto", "Helvetica Neue", "Arial", "sans-serif"]
      },
      "mono": {
        "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"]
      }
    },
    "weight": {
      "$type": "fontWeight",
      "400": { "$value": 400 },
      "500": { "$value": 500 },
      "600": { "$value": 600 },
      "700": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "$description": "Type scale, roughly a 1.2 ratio. 100 = 1rem.",
      "75": { "$value": "0.75rem" },
      "87": { "$value": "0.875rem" },
      "100": { "$value": "1rem" },
      "112": { "$value": "1.125rem" },
      "125": { "$value": "1.25rem" },
      "150": { "$value": "1.5rem" },
      "187": { "$value": "1.875rem" },
      "225": { "$value": "2.25rem" },
      "300": { "$value": "3rem" }
    },
    "line-height": {
      "$type": "number",
      "100": { "$value": 1 },
      "120": { "$value": 1.2 },
      "140": { "$value": 1.4 },
      "150": { "$value": 1.5 },
      "160": { "$value": 1.6 }
    }
  }
}
